{
  "name": "ai-radar-pwa",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "npm run dev",
    "build": "node scripts/build.mjs",
    "collect": "node scripts/collect.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:live": "node --env-file-if-exists=.env scripts/check-live.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2"
  }
}
